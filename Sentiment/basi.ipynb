   "source": [
    "import nltk\n",
    "from nltk.stem import PorterStemmer\n",
    "\n",
    "# create stemmer\n",
    "stemmer = PorterStemmer()\n",
    "\n",
    "# sentence\n",
    "text = \"playing played plays running runner easily\"\n",
    "\n",
    "# split sentence into words\n",
    "words = text.split()\n",
    "\n",
    "# apply stemming\n",
    "for word in words:\n",
    "    print(word, \"->\", stemmer.stem(word))"
   ]
  }
